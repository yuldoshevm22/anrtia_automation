        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"datasource\": { \"id\": 6, \"type\": \"table\" },\n  \"queries\": [\n    {\n      \"columns\": [\n        \"zone_prefix\",\n        \"Внешний ID\",\n        \"SKU WMS ID\",\n        \"barcodes\",\n        \"name\",\n        { \"expressionType\": \"SQL\", \"label\": \"ОСГ\", \"sqlExpression\": \"EXTRACT(DAY FROM ОСГ)\" },\n        \"amount_in_location\",\n        { \"expressionType\": \"SQL\", \"label\": \"reserved\", \"sqlExpression\": \"amount_in_location - amount_available\" },\n        \"amount_available\"\n      ],\n      \"filters\": [ { \"col\": \"partner_id\", \"op\": \"IN\", \"val\": [2] } ],\n      \"extras\": { \"where\": \"amount_in_location <> 0 OR (amount_in_location - amount_available) <> 0\" },\n      \"orderby\": [],\n      \"row_limit\": 100000\n    }\n  ],\n  \"result_format\": \"json\",\n  \"result_type\": \"results\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,

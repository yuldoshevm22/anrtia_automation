      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst raw  = $('HTTP Request1').first().json.data;\nconst rows = JSON.parse(raw).result[0].data;\n\n// barcodes может прийти массивом → склеиваем в строку\nconst asText = (v) => Array.isArray(v) ? v.join(', ') : v;\n\nreturn [{ json: { rows: rows.map(r => ({\n  \"zone_prefix\":        r[\"zone_prefix\"] ?? null,\n  \"Внешний ID\":         r[\"Внешний ID\"] ?? null,\n  \"SKU WMS ID\":         r[\"SKU WMS ID\"] ?? null,\n  \"barcodes\":           asText(r[\"barcodes\"]) ?? null,\n  \"name\":               r[\"name\"] ?? null,\n  \"ОСГ\":                r[\"ОСГ\"] ?? null,\n  \"amount_in_location\": r[\"amount_in_location\"] ?? null,\n  \"reserved\":           r[\"reserved\"] ?? null,\n  \"amount_available\":   r[\"amount_available\"] ?? null,\n})) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

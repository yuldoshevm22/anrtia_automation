    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst raw = $('HTTP Request1').first().json.data;\nconst rows = JSON.parse(raw).result[0].data;\n\nconst snapshot = new Date().toISOString().slice(0, 10); // 'YYYY-MM-DD' — дата запуска\n\nreturn [{ json: { snapshot, rows: rows.map(r => ({\n  original_invoice_number: r[\"original_invoice_number\"],\n  zone_prefix:             r[\"zone_prefix\"] ?? null,\n  cell_barcode:            r[\"cell_barcode\"],\n  barcode:                 r[\"barcode\"] ?? null,\n  sku_wms_id:              String(r[\"SKU WMS ID\"]),\n  name:                    r[\"name\"] ?? null,\n  barcodes:                r[\"barcodes\"] ?? null,\n  width:                   r[\"width\"] ?? null,\n  length:                  r[\"length\"] ?? null,\n  height:                  r[\"height\"] ?? null,\n  amount_available:        r[\"amount_available\"] ?? null,\n  amount_in_location:      r[\"amount_in_location\"] ?? null,\n  amount_incident:         r[\"amount_incident\"] ?? null,\n  osg:                     r[\"ОСГ\"] ?? null,\n  partner_id:              r[\"partner_id\"] ?? null,\n  warehouse_id:            r[\"warehouse_id\"] ?? null,\n})) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        0
      ],
      "id": "4319739a-7af3-4308-af7a-0570024b2d7e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.stock_invoice_sku_cell\n  (snapshot_date, original_invoice_number, zone_prefix, cell_barcode, barcode, sku_wms_id, name,\n   barcodes, width, length, height, amount_available, amount_in_location,\n   amount_incident, osg, partner_id, warehouse_id)\nselect\n  ($2)::date,\n  r->>'original_invoice_number',\n  r->>'zone_prefix',\n  r->>'cell_barcode',\n  r->>'barcode',\n  r->>'sku_wms_id',\n  r->>'name',\n  r->>'barcodes',\n  nullif(r->>'width','')::int,\n  nullif(r->>'length','')::int,\n  nullif(r->>'height','')::int,\n  nullif(r->>'amount_available','')::int,\n  nullif(r->>'amount_in_location','')::int,\n  nullif(r->>'amount_incident','')::int,\n  r->>'osg',\n  nullif(r->>'partner_id','')::int,\n  nullif(r->>'warehouse_id','')::int\nfrom jsonb_array_elements($1::jsonb) as r\non conflict (snapshot_date, original_invoice_number, cell_barcode, sku_wms_id, barcode, osg) do nothing;",
        "options": {
          "queryReplacement": "=={{ JSON.stringify($json.rows) }}\n={{ $json.snapshot }}"
        }

        "jsonBody": "{\n  \"datasource\": { \"id\": 6, \"type\": \"table\" },\n  \"queries\": [\n    {\n      \"columns\": [\n        \"original_invoice_number\",\n        \"zone_prefix\",\n        \"cell_barcode\",\n        \"barcode\",\n        \"SKU WMS ID\",\n        \"name\",\n        \"barcodes\",\n        \"width\",\n        \"length\",\n        \"height\",\n        \"amount_available\",\n        \"amount_in_location\",\n        \"amount_incident\",\n        {\n          \"label\": \"ОСГ\",\n          \"expressionType\": \"SQL\",\n          \"sqlExpression\": \"ОСГ\"\n        },\n        \"partner_id\",\n        \"warehouse_id\"\n      ],\n      \"row_limit\": 100000\n    }\n  ],\n  \"result_format\": \"json\",\n  \"result_type\": \"results\"\n}",

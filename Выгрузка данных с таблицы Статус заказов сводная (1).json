    },
    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst raw  = $('HTTP Request1').first().json.data;\nconst rows = JSON.parse(raw).result[0].data;\n\nconst snapshot = new Date().toISOString().slice(0, 10); // дата запуска\n\n// даты приходят epoch-мс → приводим к 'YYYY-MM-DD'\nconst fmt = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number' || /^\\d{10,13}$/.test(String(v))) {\n    return new Date(Number(v)).toISOString().slice(0, 10);\n  }\n  return v;\n};\n\nreturn [{ json: { snapshot, rows: rows.map(r => ({\n  \"Номер_заказа\":               r[\"Номер_заказа\"] ?? null,\n  \"id_заказа\":                  r[\"id_заказа\"] != null ? String(r[\"id_заказа\"]) : null,\n  \"Точка_доставки\":             r[\"Точка_доставки\"] != null ? String(r[\"Точка_доставки\"]) : null,\n  \"Статус_заказа\":              r[\"Статус_заказа\"] ?? null,\n  \"Дата_создания\":              fmt(r[\"Дата_создания\"]),\n  \"Дата_последнего_обновления\": fmt(r[\"Дата_последнего_обновления\"]),\n  \"Дата_доставки\":              fmt(r[\"Дата_доставки\"]),\n  \"Товаров_зарезервировано\":    r[\"SUM(Товаров_зарезервировано)\"] ?? null,\n})) } }];"
      },

        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"datasource\": {\n    \"id\": 54,\n    \"type\": \"table\"\n  },\n  \"queries\": [\n    {\n      \"columns\": [\n        \"Номер_заказа\",\n        \"id_заказа\",\n        \"Точка_доставки\",\n        \"Статус_заказа\",\n        \"Дата_создания\",\n        \"Дата_последнего_обновления\",\n        \"Дата_доставки\"\n      ],\n      \"metrics\": [\n        {\n          \"expressionType\": \"SIMPLE\",\n          \"column\": {\n            \"column_name\": \"Товаров_зарезервировано\",\n            \"type\": \"LONGINTEGER\"\n          },\n          \"aggregate\": \"SUM\",\n          \"label\": \"SUM(Товаров_зарезервировано)\"\n        }\n      ],\n      \"row_limit\": 50000\n    }\n  ],\n  \"result_format\": \"json\",\n  \"result_type\": \"results\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
